{
  "name": "@local/dsh-fish-tank",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "A token-fed planted aquarium with parent bonding, a nursery, rare river visitors, a fish journal, a sanctuary, and propagating plants.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "agent.md",
    "assets/",
    "scripts/",
    "UPGRADING.md",
    "account-source.js",
    "src/",
    "spec/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:core": "npm run build && node --test test/fish-store.test.mjs test/regressions.test.mjs test/tank-file.test.mjs test/account-source.test.mjs",
    "test:ui": "npm run build && node --test test/panel-flow.test.mjs",
    "assets:embed": "npm run build"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
