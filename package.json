{
  "name": "@local/dsh-fish-tank",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "A token-fed fish tank in the DSH sidebar: spent tokens become automatic food, hand feeding is always available, and fish grow, breed, and can starve.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "assets/",
    "scripts/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/fish-store.test.mjs",
    "assets:embed": "node scripts/embed-fish-atlas.mjs"
  }
}
