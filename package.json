{
  "name": "@local/dsh-fish-tank",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "A token-fed planted aquarium with parent bonding, a nursery, rare river visitors, a fish journal, a sanctuary, and propagating plants.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "assets/",
    "scripts/",
    "UPGRADING.md",
    "account-source.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/fish-store.test.mjs test/tank-file.test.mjs test/account-source.test.mjs",
    "assets:embed": "node scripts/embed-fish-atlas.mjs"
  }
}
